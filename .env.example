# Copy to .env and fill in. Never commit .env.

# Vapi private API key: dashboard.vapi.ai > Organization settings > API keys
VAPI_API_KEY=

# Filled in by setup.mjs after the first run
VAPI_ASSISTANT_ID=
VAPI_FAQ_FILE_ID=

# n8n MCP Server Trigger: open the node, copy the Production URL.
# If the URL ends in /sse set N8N_MCP_PROTOCOL=sse, otherwise shttp.
N8N_MCP_URL=
N8N_MCP_PROTOCOL=sse
# The bearer token you put in the trigger's Bearer Auth credential (any long random string)
N8N_MCP_TOKEN=

# n8n end-of-call webhook Production URL (from the Webhook node), optional but recommended
VAPI_SERVER_URL=
# Optional shared secret; Vapi sends it as the x-vapi-secret header
VAPI_SERVER_SECRET=

# Where the receptionist transfers calls during business hours, E.164
TRANSFER_NUMBER=+1XXXXXXXXXX

# Owner email for the end-of-call summary (read by the n8n logger from assistant metadata)
OWNER_EMAIL=
