        "updateFields": {
          "start": "={{ $fromAI('start', 'New visit start, ISO 8601 with timezone offset', 'string') }}",
          "end": "={{ $fromAI('end', 'New visit end, ISO 8601 with timezone offset', 'string') }}"
        }
