    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "List calendar events between two times. Every time inside the window that is not covered by a returned event is free. Pass both times in ISO 8601 with the business timezone offset, for example 2026-11-12T07:00:00-06:00. Never read event titles to the caller.",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "7751c15adce7a167c15f6c6fc7ffacb845e196e747271133397c411ad8fd6b14@group.calendar.google.com"
        },
        "returnAll": true,
        "timeMin": "={{ $fromAI('window_start', 'Start of the window to check, ISO 8601 with timezone offset', 'string') }}",
        "timeMax": "={{ $fromAI('window_end', 'End of the window to check, ISO 8601 with timezone offset', 'string') }}",
        "options": {
          "singleEvents": true,
          "orderBy": "startTime",
          "fields": "items(id,start,end,status)"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "check_availability",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        540,
        560
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Book a service visit on the calendar once the caller has confirmed the date, time, address and problem. Start and end in ISO 8601 with timezone offset; end is start plus the visit length. Returns the created event including its id.",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "7751c15adce7a167c15f6c6fc7ffacb845e196e747271133397c411ad8fd6b14@group.calendar.google.com"
        },
        "start": "={{ $fromAI('start', 'Visit start, ISO 8601 with timezone offset', 'string') }}",
        "end": "={{ $fromAI('end', 'Visit end, ISO 8601 with timezone offset', 'string') }}",
        "useDefaultReminders": true,
        "additionalFields": {
          "summary": "={{ 'Service visit: ' + $fromAI('name', 'Customer full name', 'string') }}",
          "description": "={{ 'Phone: ' + $fromAI('phone', 'Customer phone in E.164', 'string') + '\\nProblem: ' + $fromAI('problem', 'One-sentence description of the problem or service requested', 'string') + '\\nBooked by AI receptionist' }}",
          "location": "={{ $fromAI('address', 'Service address', 'string') }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "book_appointment",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        760,
        560
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Find a caller's upcoming visits by their phone number. Searches event text for the phone number between the two times. Returns events with their ids, which update_appointment and cancel_appointment need.",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "7751c15adce7a167c15f6c6fc7ffacb845e196e747271133397c411ad8fd6b14@group.calendar.google.com"
        },
        "returnAll": true,
        "timeMin": "={{ $fromAI('window_start', 'Start of the search window, usually now, ISO 8601 with offset', 'string') }}",
        "timeMax": "={{ $fromAI('window_end', 'End of the search window, usually 60 days from now, ISO 8601 with offset', 'string') }}",
        "options": {
          "singleEvents": true,
          "orderBy": "startTime",
          "query": "={{ $fromAI('phone', 'Caller phone number in E.164 format', 'string') }}",
          "fields": "items(id,summary,start,end,location,description)"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "lookup_appointment",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        980,
        560
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Move an existing visit to a new start and end. Needs the event id from lookup_appointment. Check availability for the new time first.",
        "operation": "update",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "7751c15adce7a167c15f6c6fc7ffacb845e196e747271133397c411ad8fd6b14@group.calendar.google.com"
