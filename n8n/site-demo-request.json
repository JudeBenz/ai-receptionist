{
  "name": "Website demo request · AfterRing",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "site-demo-request",
        "responseMode": "onReceived",
        "options": { "allowedOrigins": "*" }
      },
      "id": "c1000000-0000-4000-8000-000000000001",
      "name": "Website form",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.body.website ?? '' }}", "rightValue": "", "operator": { "type": "string", "operation": "empty", "singleValue": true } },
