        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000002",
      "name": "Real person? (honeypot empty, name and phone present)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "sendTo": "afterringsservices@gmail.com",
        "subject": "={{ 'Demo request: ' + ($json.body.business || 'no business given') + ' (' + ($json.body.type || 'type not given') + ')' }}",
        "emailType": "text",
        "message": "={{ 'Someone asked for a demo on the website.\\n\\nName: ' + $json.body.name + '\\nBusiness: ' + ($json.body.business || '') + '\\nPhone: ' + $json.body.phone + '\\nType of business: ' + ($json.body.type || '') + '\\nBest time to call: ' + ($json.body.when || 'not given') + '\\n\\nSent from: ' + ($json.body.page || 'unknown page') + '\\nReceived: ' + $now.setZone('America/New_York').toFormat('cccc d LLLL, h:mm a') + ' Eastern' }}",
        "options": { "appendAttribution": false }
      },
      "id": "c1000000-0000-4000-8000-000000000003",
      "name": "Email the request to AfterRing",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [520, 200]
    }
  ],
