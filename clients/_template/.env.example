# Per-client overrides. Copy to .env in this folder. Root .env still supplies VAPI_API_KEY.
# Filled in by vapi/setup.mjs --client <slug> after the first run
VAPI_ASSISTANT_ID=
VAPI_FAQ_FILE_ID=

# This client's n8n MCP Server Trigger production URL and the bearer token in its credential
N8N_MCP_URL=
N8N_MCP_PROTOCOL=sse
N8N_MCP_TOKEN=

# This client's end-of-call webhook production URL
VAPI_SERVER_URL=
VAPI_SERVER_SECRET=

# Where the receptionist transfers calls, E.164 (also in business.json phone.transfer_number; this wins)
TRANSFER_NUMBER=

# Who gets the summary email (also in business.json contact.owner_email; this wins)
OWNER_EMAIL=
